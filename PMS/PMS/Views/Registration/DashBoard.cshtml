
@{
    ViewBag.Title = "DashBoard";
}

<h2>DashBoard</h2>

<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>UserName</th>
        <th>Password</th>
        <th>Operations</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Email</td>
            <td>@item.Username</td>
            <td>@item.Password</td>
            <td>
                <a href="/Registration/Delete/@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>

<a href="/Registration/Index">Register</a>

